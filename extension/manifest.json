{
  "manifest_version": 3,
  "name": "Webyn — LinkedIn vers Clay/HubSpot",
  "version": "1.0.0",
  "description": "Reserve aux sales Webyn : enrichit un profil ou une entreprise LinkedIn via Clay et indique s'il existe deja dans HubSpot.",
  "key": "",
  "default_locale": "fr",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/in/*",
        "https://www.linkedin.com/company/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://REPLACE_ME.workers.dev/*"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["email", "profile"]
  },
  "minimum_chrome_version": "116"
}
